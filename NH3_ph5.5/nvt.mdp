integrator              = md-vv        
nsteps                  = 50000     
dt                      = 0.001     

nstxout                 = 500       
nstvout                 = 500       
nstfout                 = 500
nstenergy               = 500       
nstlog                  = 500       

continuation            = no        
constraint_algorithm    = lincs     
constraints             = h-bonds   
lincs_iter              = 1         
lincs_order             = 4         

cutoff-scheme           = Verlet    
vdwtype                 = cutoff
vdw-modifier            = force-switch
rlist                   = 1.2
ns_type                 = grid      
nstlist                 = 10        
rcoulomb                = 1.2       
rvdw                    = 1.2       
rvdw-switch             = 1.0
DispCorr                = no

coulombtype             = PME       
pme_order               = 4         
fourierspacing          = 0.1      

tcoupl                  = v-rescale            
tc-grps                 = Membrane Solv_Solu   
tau_t                   = 0.1  0.1        
ref_t                   = 298  298       

pcoupl                  = no        

pbc                     = xyz       
periodic-molecules = yes

gen_vel                 = yes       
gen_temp                = 298       
gen_seed                = -1        


comm-mode = linear 

